# Local test only - on Fly.io use `fly secrets set ...` instead of a .env file.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
# label:token pairs, comma separated; token = `openssl rand -hex 32`
MCP_AUTH_TOKENS=clickup:CHANGE_ME_64_HEX_CHARS
# Permission switches default to off/false when unset; fly.toml opts in for production.
WRITE_MODE=off
ALLOW_DELETE_FEATURE=false
# Production sets ALLOW_FEATURESCRIPT and ENABLE_LEGACY_SSE to true.
ALLOW_FEATURESCRIPT=false
ENABLE_LEGACY_SSE=false
# Extra tools to hide; export_part_studio/export_assembly are always hidden.
DISABLED_TOOLS=
WRITE_ALLOWED_NAME_PREFIX=AI-
WRITE_ALLOWED_DOCUMENT_IDS=
USAGE_FILE=./usage.json
